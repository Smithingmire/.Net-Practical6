@model WebApplication1.Models.Product
@{
    ViewBag.Title = "Details";
}
@{
    Layout = null;
}
<h2>Product Details</h2>
@if (Model != null)
{
    <p>Product Id : @Model.ProductId</p>
    <p>Product Name : @Model.ProductName</p>
    <p>Product Description : @Model.ProductDescription</p>
    <p>Product Price : @Model.ProductPrice</p>
    <p>Product Category : @Model.Category</p>
}
else
{
    <p>Product not found</p>
}
<br/>
@Html.ActionLink("Back to Product Catalog", "Index", "Product")